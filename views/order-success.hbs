                    <a href="#"><i class="fas fa-search"></i></a>
                    <a href="#"><i class="fas fa-user"></i></a>
                    <a href="cart.html" class="cart-icon"><i class="fas fa-shopping-bag"></i><span class="cart-count">0</span></a>
                </div>
                <div class="mobile-menu-btn">
                    <i class="fas fa-bars"></i>
                </div>
            </div>
        </div>
    </header>

    <!-- Mobile Menu -->
    <div class="mobile-menu">
        <div class="mobile-menu-content">
            <div class="mobile-menu-header">
                <div class="logo">ENCANTO VESTE</div>
                <div class="close-menu-btn"><i class="fas fa-times"></i></div>
            </div>
            <ul>
                <li><a href="index.html">Home</a></li>
                <li><a href="shop.html">Shop</a></li>
                <li><a href="collections.html">Collections</a></li>
                <li><a href="about.html">About</a></li>
                <li><a href="contact.html">Contact</a></li>
            </ul>
            <div class="mobile-menu-footer">
                <div class="social-icons">
                    <a href="#"><i class="fab fa-instagram"></i></a>
                    <a href="#"><i class="fab fa-facebook-f"></i></a>
                    <a href="#"><i class="fab fa-twitter"></i></a>
                    <a href="#"><i class="fab fa-pinterest"></i></a>
                </div>
            </div>
        </div>
    </div>

    <!-- Order Complete Section -->
    <section class="order-complete-section">
        <div class="container">
            <div class="order-complete-content">
                <div class="order-complete-header">
                    <div class="icon-circle">
                        <i class="fas fa-check"></i>
                    </div>
                    <h1 class="section-title">Order Completed</h1>
                    <p class="order-number">Order #EV-2023-45678</p>
                    <p class="thank-you">Thank you for your purchase! Your order has been received and is being processed.</p>
                </div>

                <div class="order-details">
                    <div class="details-card">
                        <h3>Order Details</h3>
                        <div class="detail-row">
                            <span>Order Number:</span>
                            <span>EV-2023-45678</span>
                        </div>
                        <div class="detail-row">
                            <span>Date:</span>
                            <span>October 15, 2023</span>
                        </div>
                        <div class="detail-row">
                            <span>Total:</span>
                            <span>$429.96</span>
                        </div>
                        <div class="detail-row">
                            <span>Payment Method:</span>
                            <span>Credit Card (VISA •••• 4242)</span>
                        </div>
                    </div>

                    <div class="details-card">
                        <h3>Billing Address</h3>
                        <address>
                            <p>Sarah Johnson</p>
                            <p>123 Fashion Street, Apt 4B</p>
                            <p>New York, NY 10001</p>
                            <p>United States</p>
                            <p>(123) 456-7890</p>
                            <p>sarah.johnson@example.com</p>
                        </address>
                    </div>

                    <div class="details-card">
                        <h3>Shipping Address</h3>
                        <address>
                            <p>Sarah Johnson</p>
                            <p>123 Fashion Street, Apt 4B</p>
                            <p>New York, NY 10001</p>
                            <p>United States</p>
                            <p>(123) 456-7890</p>
                        </address>
                    </div>
                </div>

                <div class="order-items">
                    <h2>Your Order</h2>
                    <div class="order-table">
                        <div class="order-header">
                            <div class="product-col">Product</div>
                            <div class="total-col">Total</div>
                        </div>
                        <div class="order-items-list">
                            <div class="order-item">
                                <div class="product-col">
                                    <span class="product-name">Premium Leather Jacket</span>
                                    <span class="product-quantity">× 1</span>
                                </div>
                                <div class="total-col">$249.99</div>
                            </div>
                            <div class="order-item">
                                <div class="product-col">
                                    <span class="product-name">Silk Evening Blouse</span>
                                    <span class="product-quantity">× 1</span>
                                </div>
                                <div class="total-col">$129.99</div>
                            </div>
                            <div class="order-item">
                                <div class="product-col">
                                    <span class="product-name">Designer Slim Jeans</span>
                                    <span class="product-quantity">× 1</span>
                                </div>
                                <div class="total-col">$89.99</div>
                            </div>
                        </div>
                        <div class="order-totals">
                            <div class="total-row">
                                <span>Subtotal:</span>
                                <span>$469.97</span>
                            </div>
                            <div class="total-row">
                                <span>Shipping:</span>
                                <span>$9.99</span>
                            </div>
                            <div class="total-row">
                                <span>Discount:</span>
                                <span>-$50.00</span>
                            </div>
                            <div class="total-row grand-total">
                                <span>Total:</span>
                                <span>$429.96</span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="order-actions">
                    <a href="shop.html" class="btn-outline"><i class="fas fa-arrow-left"></i> Continue Shopping</a>
                    <a href="order-tracking.html" class="btn">Track Your Order</a>
                </div>

                <div class="customer-support">
                    <h3>Need Help?</h3>
                    <p>If you have any questions about your order, please contact our customer support team.</p>
                    <div class="support-options">
                        <a href="contact.html" class="support-option">
                            <i class="fas fa-envelope"></i>
                            <span>Email Us</span>
                        </a>
                        <a href="tel:+11234567890" class="support-option">
                            <i class="fas fa-phone"></i>
                            <span>Call Us</span>
                        </a>
                        <a href="faq.html" class="support-option">
                            <i class="fas fa-question-circle"></i>
                            <span>FAQs</span>
                        </a>
                    </div>
                </div>
            </div>
        </div>
