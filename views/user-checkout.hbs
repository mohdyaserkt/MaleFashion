<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Checkout | Encanto Veste</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600;700&family=Playfair+Display:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="\css\encantoVesteCheckoutPage.css">

</head>
<body>
    <!-- Header/Navbar -->
    <header class="header">
        <div class="container">
            <div class="header-content">
                <div class="logo">
                    <a href="index.html">ENCANTO VESTE</a>
                </div>
                <nav class="navbar">
                    <ul>
                        <li><a href="index.html">Home</a></li>
                        <li><a href="shop.html">Shop</a></li>
                        <li><a href="collections.html">Collections</a></li>
                        <li><a href="about.html">About</a></li>
                        <li><a href="contact.html">Contact</a></li>
                    </ul>
                </nav>
                <div class="header-icons">
                    <a href="#"><i class="fas fa-search"></i></a>
                    <a href="#"><i class="fas fa-user"></i></a>
                    <a href="cart.html" class="cart-icon"><i class="fas fa-shopping-bag"></i><span class="cart-count">3</span></a>
                </div>
                <div class="mobile-menu-btn">
                    <i class="fas fa-bars"></i>
                </div>
            </div>
        </div>
    </header>

    <!-- Mobile Menu -->
    <div class="mobile-menu">
        <div class="mobile-menu-content">
            <div class="mobile-menu-header">
                <div class="logo">ENCANTO VESTE</div>
                <div class="close-menu-btn"><i class="fas fa-times"></i></div>
            </div>
            <ul>
                <li><a href="index.html">Home</a></li>
                <li><a href="shop.html">Shop</a></li>
                <li><a href="collections.html">Collections</a></li>
                <li><a href="about.html">About</a></li>
                <li><a href="contact.html">Contact</a></li>
            </ul>
            <div class="mobile-menu-footer">
                <div class="social-icons">
                    <a href="#"><i class="fab fa-instagram"></i></a>
                    <a href="#"><i class="fab fa-facebook-f"></i></a>
                    <a href="#"><i class="fab fa-twitter"></i></a>
                    <a href="#"><i class="fab fa-pinterest"></i></a>
                </div>
            </div>
        </div>
    </div>

    <!-- Checkout Section -->
    <section class="checkout-section">
        <div class="container">
            <div class="checkout-header">
                <h1 class="section-title">Checkout</h1>
                <div class="checkout-steps">
                    <div class="step">
                        <span>1</span>
                        <p>Shopping Cart</p>
                    </div>
                    <div class="step active">
                        <span>2</span>
                        <p>Checkout</p>
                    </div>
                    <div class="step">
                        <span>3</span>
                        <p>Order Complete</p>
                    </div>
                </div>
            </div>

            <div class="checkout-content">
                <div class="checkout-form">
                    <h2>Billing Details</h2>
                    
                    <!-- Saved Addresses -->
                    <div class="saved-addresses">
                        <h3>Select Saved Address</h3>
                        <div class="address-options">
                            <div class="address-option selected">
                                <input type="radio" name="saved-address" id="address-1" checked>
                                <label for="address-1">
                                    <strong>Home</strong>
                                    <p>123 Fashion Street, Apt 4B</p>
                                    <p>New York, NY 10001</p>
                                    <p>United States</p>
                                    <p>Phone: (123) 456-7890</p>
                                </label>
                            </div>
                            <div class="address-option">
                                <input type="radio" name="saved-address" id="address-2">
                                <label for="address-2">
                                    <strong>Work</strong>
                                    <p>456 Design Avenue, Floor 12</p>
                                    <p>New York, NY 10005</p>
                                    <p>United States</p>
                                    <p>Phone: (123) 456-7891</p>
                                </label>
                            </div>
                            <button class="btn-outline add-new-address">
                                <i class="fas fa-plus"></i> Add New Address
                            </button>
                        </div>
                    </div>

                    <!-- Billing Form -->
                    <form id="billing-form">
                        <div class="form-row">
                            <div class="form-group">
                                <label for="first-name">First Name*</label>
                                <input type="text" id="first-name" required>
                            </div>
                            <div class="form-group">
                                <label for="last-name">Last Name*</label>
                                <input type="text" id="last-name" required>
                            </div>
                        </div>
                        <div class="form-group">
                            <label for="address">Address*</label>
                            <input type="text" id="address" required>
                        </div>
                        <div class="form-group">
                            <label for="locality">Locality*</label>
                            <input type="text" id="locality" required>
                        </div>
                        <div class="form-group">
                            <label for="landmark">Landmark</label>
                            <input type="text" id="landmark">
                        </div>
                        <div class="form-row">
                            <div class="form-group">
                                <label for="city">Town/City*</label>
                                <input type="text" id="city" required>
                            </div>
                            <div class="form-group">
                                <label for="state">State*</label>
                                <input type="text" id="state" required>
                            </div>
                        </div>
                        <div class="form-row">
                            <div class="form-group">
                                <label for="postcode">Postcode/ZIP*</label>
                                <input type="text" id="postcode" required>
                            </div>
                            <div class="form-group">
                                <label for="country">Country*</label>
                                <select id="country" required>
                                    <option value="">Select Country</option>
                                    <option value="US" selected>United States</option>
                                    <option value="UK">United Kingdom</option>
                                    <option value="CA">Canada</option>
                                    <option value="AU">Australia</option>
                                </select>
                            </div>
                        </div>
                        <div class="form-row">
                            <div class="form-group">
                                <label for="phone">Phone*</label>
                                <input type="tel" id="phone" required>
                            </div>
                            <div class="form-group">
                                <label for="alt-phone">Alternative Phone</label>
                                <input type="tel" id="alt-phone">
                            </div>
                        </div>
                        <div class="form-group">
                            <label for="order-notes">Order Notes (Optional)</label>
                            <textarea id="order-notes" rows="4" placeholder="Notes about your order, e.g. special notes for delivery"></textarea>
                        </div>
                    </form>
                </div>

                <div class="order-summary">
                    <h2>Your Order</h2>
                    <div class="order-details">
                        <div class="order-header">
                            <div class="product-col">Product</div>
                            <div class="total-col">Total</div>
                        </div>
                        <div class="order-items">
                            <div class="order-item">
                                <div class="product-col">Premium Leather Jacket × 1</div>
                                <div class="total-col">$249.99</div>
                            </div>
                            <div class="order-item">
                                <div class="product-col">Silk Evening Blouse × 1</div>
                                <div class="total-col">$129.99</div>
                            </div>
                            <div class="order-item">
                                <div class="product-col">Designer Slim Jeans × 1</div>
                                <div class="total-col">$89.99</div>
                            </div>
                        </div>
                        <div class="order-totals">
                            <div class="total-row">
                                <span>Subtotal</span>
                                <span>$469.97</span>
                            </div>
                            <div class="total-row">
                                <span>Shipping</span>
                                <span>$9.99</span>
                            </div>
                            <div class="total-row">
                                <span>Discount</span>
                                <span>-$50.00</span>
                            </div>
                            <div class="total-row grand-total">
                                <span>Total</span>
                                <span>$429.96</span>
                            </div>
                        </div>

                        <!-- Wallet Balance -->
                        <div class="wallet-balance">
                            <div class="balance-header">
                                <i class="fas fa-wallet"></i>
                                <span>Wallet Balance: $150.00</span>
                            </div>
                            <div class="use-wallet">
                                <input type="checkbox" id="use-wallet">
                                <label for="use-wallet">Use wallet balance ($150.00 available)</label>
                            </div>
                            <div class="remaining-balance">
                                Remaining after wallet: <span>$279.96</span>
                            </div>
                        </div>

                        <!-- Payment Methods -->
                        <div class="payment-methods">
                            <h3>Payment Method</h3>
                            <div class="payment-option">
                                <input type="radio" name="payment-method" id="cod" checked>
                                <label for="cod">
                                    <i class="fas fa-money-bill-wave"></i>
                                    <span>Cash on Delivery</span>
                                </label>
                            </div>
                            <div class="payment-option">
                                <input type="radio" name="payment-method" id="online-payment">
                                <label for="online-payment">
                                    <i class="fas fa-credit-card"></i>
                                    <span>Online Payment</span>
                                </label>
                                <div class="payment-icons">
                                    <i class="fab fa-cc-visa"></i>
                                    <i class="fab fa-cc-mastercard"></i>
                                    <i class="fab fa-cc-amex"></i>
                                    <i class="fab fa-cc-paypal"></i>
                                </div>
                            </div>
                            <div class="payment-option">
                                <input type="radio" name="payment-method" id="wallet-payment">
                                <label for="wallet-payment">
                                    <i class="fas fa-wallet"></i>
                                    <span>Wallet Payment</span>
                                </label>
                            </div>
                        </div>

                        <div class="terms-agreement">
                            <input type="checkbox" id="terms" required>
                            <label for="terms">I have read and agree to the website <a href="#">terms and conditions</a>*</label>
                        </div>

                        <button type="submit" form="billing-form" class="btn place-order-btn">Place Order</button>

                        <div class="secure-checkout">
                            <i class="fas fa-lock"></i>
                            <span>Secure Checkout</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Footer -->
    <footer class="footer">
        <div class="container">
            <div class="footer-grid">
                <div class="footer-col">
                    <h3>ENCANTO VESTE</h3>
                    <p>Premium fashion for those who appreciate quality and timeless style.</p>
                    <div class="social-icons">
                        <a href="#"><i class="fab fa-instagram"></i></a>
                        <a href="#"><i class="fab fa-facebook-f"></i></a>
                        <a href="#"><i class="fab fa-twitter"></i></a>
                        <a href="#"><i class="fab fa-pinterest"></i></a>
                    </div>
                </div>
                <div class="footer-col">
                    <h3>Shop</h3>
                    <ul>
                        <li><a href="#">Men's Collection</a></li>
                        <li><a href="#">Women's Collection</a></li>
                        <li><a href="#">Accessories</a></li>
                        <li><a href="#">New Arrivals</a></li>
                        <li><a href="#">Sale</a></li>
                    </ul>
                </div>
                <div class="footer-col">
                    <h3>Customer Service</h3>
                    <ul>
                        <li><a href="#">Contact Us</a></li>
                        <li><a href="#">FAQs</a></li>
                        <li><a href="#">Shipping & Returns</a></li>
                        <li><a href="#">Size Guide</a></li>
                        <li><a href="#">Track Order</a></li>
                    </ul>
                </div>
                <div class="footer-col">
                    <h3>About</h3>
                    <ul>
                        <li><a href="#">Our Story</a></li>
                        <li><a href="#">Sustainability</a></li>
                        <li><a href="#">Careers</a></li>
                        <li><a href="#">Privacy Policy</a></li>
                        <li><a href="#">Terms & Conditions</a></li>
                    </ul>
                </div>
            </div>
            <div class="footer-bottom">
                <p>&copy; 2023 Encanto Veste. All rights reserved.</p>
                <div class="payment-methods">
                    <i class="fab fa-cc-visa"></i>
                    <i class="fab fa-cc-mastercard"></i>
                    <i class="fab fa-cc-amex"></i>
                    <i class="fab fa-cc-paypal"></i>
                    <i class="fab fa-cc-apple-pay"></i>
                </div>
            </div>
        </div>
    </footer>

    <script src="checkout.js"></script>
</body>
</html>