<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Shop | Encanto Veste</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link
        href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700&family=Playfair+Display:wght@700&display=swap"
        rel="stylesheet">
    <link rel="stylesheet" href="/css/encantoVesteShopPage.css">
    {{!--
    <link rel="stylesheet" href="/css/encantoVesteHomePage.css"> --}}
</head>

<body>
    <header class="header">
        <div class="container">
            <div class="header-content">
                <div class="logo">
                    <a href="../index.html">ENCANTO VESTE</a>
                </div>
                <nav class="navbar">
                    <ul>
                        <li><a href="../index.html">Home</a></li>
                        <li><a href="../shop.html">Shop</a></li>
                        <li><a href="../collections.html">Collections</a></li>
                        <li><a href="profile.html" class="active">My Account</a></li>
                    </ul>
                </nav>
                <div class="header-icons">
                    <a href="../search.html"><i class="fas fa-search"></i></a>
                    <a href="../wishlist.html"><i class="far fa-heart"></i></a>
                    <a href="../cart.html" class="cart-icon"><i class="fas fa-shopping-bag"></i><span
                            class="cart-count">3</span></a>
                </div>
            </div>
        </div>
    </header>

    <!-- Shop Hero Section -->
    <section class="shop-hero">
        <div class="container">
            <h1>Our Collection</h1>
            <p>Discover premium fashion pieces for every occasion</p>
        </div>
    </section>

   <div class="container">
  <div class="controls-grid">
    <!-- New Search Field -->
    <div class="filter-group search-field">
      <label for="productSearch">Search:</label>
      <input type="text" id="productSearch" placeholder="Search products..." >
    </div>

    <!-- Category Filter -->
    <div class="filter-group">
      <label for="categoryFilter">Category:</label>
      <select id="categoryFilter" onchange="handleCategoryChange(this.value)">
        <option value="all">All Categories</option>
        {{#each productDetails}}
        <option value="{{categoryname}}">{{categoryname}}</option>
        {{/each}}
      </select>
    </div>

    <!-- Price Filter -->
    <div class="filter-group">
      <label for="priceFilter">Price:</label>
      <select id="priceFilter" onchange="handlePriceChange(this.value)">
        <option value="all">All Prices</option>
        <option value="500-600">₹500 - ₹600</option>
        <option value="600-700">₹600 - ₹700</option>
        <option value="800-900">₹800 - ₹900</option>
        <option value="1000-1100">₹1000 - ₹1100</option>
        <option value="1200-1300">₹1200 - ₹1300</option>
        <option value="1300+">₹1300+</option>
      </select>
    </div>

    <!-- Sort By -->
    <div class="filter-group">
      <label for="sortBy">Sort By:</label>
      <select id="sortBy" onchange="handleSortChange(this.value)">
        <option value="DFT">Featured</option>
        <option value="LTH">Price: Low to High</option>
        <option value="HTL">Price: High to Low</option>
      </select>
    </div>

    <!-- View Toggle -->
    <div class="view-toggle">
      <button class="view-btn active" data-view="grid"><i class="fas fa-th"></i></button>
      <button class="view-btn" data-view="list"><i class="fas fa-list"></i></button>
    </div>
  </div>
</div>

    <!-- Products Grid -->
    <section class="products-section">
        <div class="container">
            <div class="products-grid" id="productsGrid">
                <!-- Product cards will be inserted here by JavaScript -->
                {{#each products}}
                <div class="product-card">
                    <span class="product-badge">New</span>
                    <div class="product-image">
                        <img src="{{image.[0]}}" alt="{{title}}">
                        <div class="product-actions">
                            <button class="quick-view" data-id="1">Quick View</button>
                            <button class="add-to-wishlist" onclick="addToWishlist('{{productid}}')"><i
                                    class="far fa-heart"></i></button>
                        </div>
                    </div>
                    <div class="product-info">
                        <h3 class="product-title">{{title}}</h3>
                        <div class="product-price">
                            <span class="current-price">₹{{price}}</span>
                            {{!-- ${product.originalPrice ? `<span
                                class="original-price">$${product.originalPrice.toFixed(2)}</span>`
                            : ''}
                            ${discount > 0 ? `<span class="discount">${discount}% OFF</span>` : ''} --}}
                        </div>
                        <button onclick="window.location.href='/product-details/{{_id}}'" class="add-to-cart">Add to Cart</button>
                    </div>
                </div>
                 {{/each}}
            </div>

            <!-- Pagination -->
            <div class="pagination">
                <button class="page-btn disabled"><i class="fas fa-chevron-left"></i></button>
                <button class="page-btn active">1</button>
                <button class="page-btn">2</button>
                <button class="page-btn">3</button>
                <button class="page-btn"><i class="fas fa-chevron-right"></i></button>
            </div>
        </div>
    </section>

    
    <!-- Footer (Same as Homepage) -->
    <footer class="footer">
        <!-- Your existing footer code -->
    </footer>
    <script>
        document.getElementById("productSearch").addEventListener("input", searchProducts);

    function searchProducts() {
        // Get the search input value
        var searchInput = document.getElementById("productSearch").value.toLowerCase();

        // Loop through all the product cards and hide/show them based on search input
        var productCards = document.querySelectorAll(".product-card");
        for (var i = 0; i < productCards.length; i++) {
            var productName = productCards[i].querySelector(".product-info").textContent.toLowerCase();
            if (productName.indexOf(searchInput) > -1) {
                productCards[i].style.display = "";
            } else {
                productCards[i].style.display = "none";
            }
        }
    }
        // Filter handlers
        function handleCategoryChange(category) {
            window.location.href = `/category/${category}`
        }

        function handlePriceChange(priceRange) {
            const [from, to] = priceRange.split('-')
            window.location.href = `/price-filter/?from=${from}&to=${to}`
        }

        function handleSortChange(sortValue) {
            window.location.href = `/sort/${sortValue}`
        }

       function addToWishlist(id) {
    $.ajax({
      url: "/add-to-wishlist",
      data: {
        productid: id,
      },
      method: "POST",
      success: (response) => {
        if (response.status == true) {
          const Toast = Swal.mixin({
            toast: true,
            position: "top-end",
            showConfirmButton: false,
            iconColor: "#a5dc86",
            background: "black",
            color: "#a5dc86",

            timer: 3000,
            timerProgressBar: true,
            didOpen: (toast) => {
              toast.addEventListener("mouseenter", Swal.stopTimer);
              toast.addEventListener("mouseleave", Swal.resumeTimer);
            },
          });

          Toast.fire({
            icon: "success",
            title: "Product Added TO Wishlist",
          });
        } else {
          window.location.href = "/user-login-email";
        }
      },
    });
  }

       
    </script>

   
<script src="/js/encantoVesteShopPage.js"></script>
</body>

</html>