<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>My Account | Encanto Veste</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700&family=Playfair+Display:wght@700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/encantoVesteProfilePage.css">
  {{!-- <link rel="stylesheet" href="/css/encantoVesteHomePage.css">
  <link rel="stylesheet" href="/css/encantoVesteAuthPage.css"> --}}
   <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body>
  <!-- Header (Same as Homepage) -->
  <header class="header">
    <div class="container">
      <div class="header-content">
        <div class="logo">
          <a href="../index.html">ENCANTO VESTE</a>
        </div>
        <nav class="navbar">
          <ul>
            <li><a href="../index.html">Home</a></li>
            <li><a href="../shop.html">Shop</a></li>
            <li><a href="../collections.html">Collections</a></li>
            <li><a href="profile.html" class="active">My Account</a></li>
          </ul>
        </nav>
        <div class="header-icons">
          <a href="../search.html"><i class="fas fa-search"></i></a>
          <a href="../wishlist.html"><i class="far fa-heart"></i></a>
          <a href="../cart.html" class="cart-icon"><i class="fas fa-shopping-bag"></i><span class="cart-count">3</span></a>
        </div>
      </div>
    </div>
  </header>

  <!-- Updated Profile Section -->
<section class="profile-section">
  <div class="container">
    <div class="profile-grid">
      <!-- Sidebar Navigation -->
      <div class="profile-sidebar">
        <div class="user-card">
          <div class="avatar">
            <img src="https://images.unsplash.com/photo-1438761681033-6461ffad8d80?ixlib=rb-4.0.3&auto=format&fit=crop&w=500&q=80" alt="User Avatar">
          </div>
           {{#user}}
          <h3>{{name}}</h3>
          <p class="email">{{email}}</p>
          <div class="wallet-balance">
            <i class="fas fa-wallet"></i>
            <span>₹ {{#if wallet}}{{wallet}}{{else}}0{{/if}}</span>
          </div>
           {{/user}}
        </div>

        <nav class="profile-menu">
          <ul>
            <li class="active"><a href="/user-profile"><i class="fas fa-user"></i> Profile</a></li>
            <li><a href="/orders-list"><i class="fas fa-box-open"></i> My Orders</a></li>
            <li><a href="/saved-address"><i class="fas fa-map-marker-alt"></i> Addresses</a></li>
            <li><a href="/wishlist"><i class="far fa-heart"></i> Wishlist</a></li>
            <li><a href="/user-logout" id="logout-btn"><i class="fas fa-sign-out-alt"></i> Logout</a></li>
          </ul>
        </nav>
      </div>

      <!-- Main Content -->
      <div class="profile-content">
        <!-- Personal Info Card -->
        <div class="profile-card">
          <div class="card-header">
            <h2>Personal Information</h2>
            <button class="btn-edit" id="editPersonalInfo"><i class="fas fa-pencil-alt"></i> Edit</button>
          </div>
          <div class="card-body">
            <form id="personalInfoForm" method="post" action="/user-edit-personal-details">
               {{#user}}
              <div class="info-row">
                <span class="info-label">Full Name</span>
                 <span class="info-value" id="displayName">{{name}}</span>
                <input type="text" name="name" class="edit-input" value="{{name}}" >
              </div>
              <div class="info-row">
                <span class="info-label">Username</span>
                  <span class="info-value" id="displayUsername">{{username}}</span>
                <input type="text" name="username" class="edit-input" value="{{username}}" >
              </div>
              <div class="info-row">
                <span class="info-label">Email</span>
                <span class="info-value" id="displayEmail">{{email}}</span>
               
              </div>
              <div class="info-row">
                <span class="info-label">Phone</span>
                <span class="info-value" id="displayPhone">{{phone}}</span>
                <input type="tel" name="phone" class="edit-input" value="{{phone}}" >
              </div>
               {{/user}}
              <div class="action-buttons" id="personalInfoActions" style="display: none;">
                <button type="button" class="btn-cancel" id="cancelPersonalEdit">Cancel</button>
                <button type="submit" class="btn-save">Save Changes</button>
              </div>
              <div id="profileMessage" class="message"></div>
            </form>
          </div>
        </div>

        <!-- Change Password Card -->
        <div class="profile-card">
          <div class="card-header">
            <h2>Change Password</h2>
          </div>
          <div class="card-body">
            <form id="passwordForm" method="post" action="/user-change-password">
              <div class="input-group">
                <label for="currentPassword">Current Password</label>
                <input type="password" name="password" id="currentPassword" required>
                <a href="/forget-password" class="forgot-password">Forgot Password?</a>
              </div>
              <div class="input-group">
                <label for="newPassword">New Password</label>
                <input type="password" name="newpassword" id="newPassword" 
                  pattern="^(?=.*[0-9])(?=.*[!@#$%^&*])[a-zA-Z0-9!@#$%^&*]{8,16}$" required>
              </div>
              <div class="input-group">
                <label for="confirmPassword">Confirm New Password</label>
                <input type="password" name="verifypassword" id="confirmPassword" 
                  oninput="checkPasswordMatch(this)" required>
              </div>
              <div id="passwordMessage" class="message"></div>
              <button type="submit" class="btn-save">Update Password</button>
            </form>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
<!-- Footer (Same as Homepage) -->
  <footer class="footer">
    <!-- Your existing footer code -->
  </footer>
<script>
  // Personal Info Edit Toggle
  const editPersonalInfo = document.getElementById('editPersonalInfo');
  const cancelPersonalEdit = document.getElementById('cancelPersonalEdit');
  const inputs = document.querySelectorAll('#personalInfoForm input');


  // Password Match Validation
  function checkPasswordMatch(input) {
    const newPassword = document.getElementById('newPassword');
    const message = document.getElementById('passwordMessage');
    
    if (input.value !== newPassword.value) {
      message.textContent = 'Passwords do not match!';
      message.style.color = 'var(--error)';
      input.setCustomValidity('Passwords do not match');
    } else {
      message.textContent = '';
      input.setCustomValidity('');
    }
  }

  // Form Submission Handling
  document.getElementById('personalInfoForm').addEventListener('submit', async (e) => {
    e.preventDefault();
    
    try {
      const response = await fetch('/user-edit-personal-details', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json'
        },
        body: JSON.stringify({
          name: document.querySelector('[name="name"]').value,
          username: document.querySelector('[name="username"]').value,
          phone: document.querySelector('[name="phone"]').value
        })
      });

      const data = await response.json();
      
      if (data.success) {
        document.getElementById('profileMessage').textContent = 'Profile updated successfully!';
        document.getElementById('profileMessage').style.color = 'var(--success)';
        cancelPersonalEdit.click();
      } else {
        document.getElementById('profileMessage').textContent = data.message;
        document.getElementById('profileMessage').style.color = 'var(--error)';
      }
    } catch (error) {
      console.error('Error:', error);
    }
  });

  document.getElementById('passwordForm').addEventListener('submit', async (e) => {
    e.preventDefault();
    
    const formData = new FormData(e.target);
    const data = Object.fromEntries(formData.entries());

    try {
      const response = await fetch('/user-change-password', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json'
        },
        body: JSON.stringify(data)
      });

      const result = await response.json();
      
      if (result.success) {
        document.getElementById('passwordMessage').textContent = 'Password changed successfully!';
        document.getElementById('passwordMessage').style.color = 'var(--success)';
        e.target.reset();
      } else {
        document.getElementById('passwordMessage').textContent = result.message;
        document.getElementById('passwordMessage').style.color = 'var(--error)';
      }
    } catch (error) {
      console.error('Error:', error);
    }
  });
</script>
  

  <script src="/js/encantoVesteProfilePage.js"></script>
</body>
</html>