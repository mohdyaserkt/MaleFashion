<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Encanto Veste | Reset Password</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700&family=Playfair+Display:wght@700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/encantoVesteAuthPage.css">
</head>
<body>
  <div class="auth-grid">
    <!-- Visual Section -->
    <div class="auth-visual" style="background-image: url('https://images.unsplash.com/photo-1551232864-3f0890e580d9?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=686&q=80')">
      <div class="overlay"></div>
      <div class="branding">
        <div class="logo">ENCANTO VESTE</div>
        <h2>Reset Your Password</h2>
        <p>Secure your account with a new password</p>
      </div>
    </div>

    <!-- Form Section -->
    <div class="auth-form">
      <div class="form-container">
        <div class="logo-mobile">ENCANTO VESTE</div>
        <h1 id="formTitle">Reset Password</h1>
        <p class="subtitle" id="formSubtitle">Enter your email to receive a verification code</p>

        <form id="resetForm">
          <!-- Email Input (Step 1) -->
          <div id="emailSection">
            <div class="input-group">
              <i class="fas fa-envelope"></i>
              <input type="email" id="resetEmail" placeholder="your@email.com" required>
            </div>
          </div>

          <!-- OTP Verification (Step 2) -->
          <div id="otpSection" style="display:none;">
            <p class="otp-instruction">Enter 6-digit code sent to <span id="otpEmailDisplay"></span></p>
            <div class="otp-container">
              <input type="text" maxlength="1" pattern="[0-9]" >
              <input type="text" maxlength="1" pattern="[0-9]" >
              <input type="text" maxlength="1" pattern="[0-9]" >
              <input type="text" maxlength="1" pattern="[0-9]" >
              <input type="text" maxlength="1" pattern="[0-9]" >
              <input type="text" maxlength="1" pattern="[0-9]" >
            </div>
            <p class="otp-resend">Didn't receive code? <a href="#" id="resendOtp">Resend</a></p>
          </div>

          <!-- New Password (Step 3) -->
          <div id="passwordSection" style="display:none;">
            <div class="input-group">
              <i class="fas fa-lock"></i>
              <input type="password" id="newPassword" placeholder="New password" >
              <button type="button" class="toggle-password"><i class="fas fa-eye"></i></button>
            </div>
            <div class="input-group">
              <i class="fas fa-lock"></i>
              <input type="password" id="confirmPassword" placeholder="Confirm new password" >
            </div>
            <div class="password-hints">
              <p>Use 8+ characters with mix of letters, numbers & symbols</p>
            </div>
          </div>

          <div id="errorMessage" class="error-message"></div>

          <button type="submit" class="btn btn-primary" id="submitBtn">
            <span id="btnText">Send Verification Code</span>
            <i class="fas fa-paper-plane" id="btnIcon"></i>
          </button>
        </form>

        <div class="divider">
          <span>or</span>
        </div>

        <p class="auth-switch">Remember your password? <a href="/user-login-email">Sign in</a></p>
      </div>
    </div>
  </div>

  <script>
    let currentStep = 1;
    let userEmail = '';
    let cooldownInterval;

    // Initialize OTP inputs
    const setupOTPInputs = () => {
      const otpInputs = document.querySelectorAll('#otpSection input');
      
      otpInputs.forEach((input, index) => {
        input.addEventListener('input', (e) => {
          if (e.target.value.length === 1 && index < otpInputs.length - 1) {
            otpInputs[index + 1].focus();
          }
        });

        input.addEventListener('keydown', (e) => {
          if (e.key === 'Backspace' && index > 0 && !e.target.value) {
            otpInputs[index - 1].focus();
          }
        });
      });
    };

    // Toggle password visibility
    document.querySelector('.toggle-password')?.addEventListener('click', function() {
      const passwordInput = document.getElementById('newPassword');
      const icon = this.querySelector('i');
      
      if (passwordInput.type === 'password') {
        passwordInput.type = 'text';
        icon.classList.replace('fa-eye', 'fa-eye-slash');
      } else {
        passwordInput.type = 'password';
        icon.classList.replace('fa-eye-slash', 'fa-eye');
      }
    });

    // Form submission handler
    document.getElementById('resetForm').addEventListener('submit', async (e) => {
      e.preventDefault();
      const errorElement = document.getElementById('errorMessage');
      errorElement.textContent = '';

      try {
        if (currentStep === 1) {
          // Step 1: Request OTP
          userEmail = document.getElementById('resetEmail').value.trim();
          
          const response = await fetch('/api/request-password-reset', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ email: userEmail })
          });

          const data = await response.json();
          if (!response.ok) throw new Error(data.message || 'Failed to send OTP');

          // Move to step 2
          currentStep = 2;
          document.getElementById('emailSection').style.display = 'none';
          document.getElementById('otpSection').style.display = 'block';
          document.getElementById('otpEmailDisplay').textContent = userEmail;
          document.getElementById('formTitle').textContent = 'Verify Your Email';
          document.getElementById('formSubtitle').textContent = '';
          document.getElementById('btnText').textContent = 'Verify Code';
          document.getElementById('btnIcon').className = 'fas fa-check';
          setupOTPInputs();
          startResendCooldown();

        } else if (currentStep === 2) {
          // Step 2: Verify OTP
          const otp = Array.from(document.querySelectorAll('#otpSection input'))
                       .map(input => input.value)
                       .join('');

          const response = await fetch('/api/verify-password-reset', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ email: userEmail, otp })
          });

          const data = await response.json();
          if (!response.ok) throw new Error(data.message || 'Invalid verification code');

          // Move to step 3
          currentStep = 3;
          document.getElementById('otpSection').style.display = 'none';
          document.getElementById('passwordSection').style.display = 'block';
          document.getElementById('formTitle').textContent = 'Create New Password';
          document.getElementById('btnText').textContent = 'Reset Password';
          document.getElementById('btnIcon').className = 'fas fa-lock';

        } else if (currentStep === 3) {
          // Step 3: Set new password
          const newPassword = document.getElementById('newPassword').value;
          const confirmPassword = document.getElementById('confirmPassword').value;

          if (newPassword !== confirmPassword) {
            throw new Error('Passwords do not match');
          }

          const response = await fetch('/api/update-password', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ email: userEmail, password: newPassword })
          });

          const data = await response.json();
          if (!response.ok) throw new Error(data.message || 'Password update failed');

          // Success - redirect to login
          window.location.href = '/user-login-email?message=Password+reset+successfully';
        }
      } catch (error) {
        errorElement.textContent = error.message;
      }
    });

    // Resend OTP handler
    document.getElementById('resendOtp')?.addEventListener('click', async (e) => {
      e.preventDefault();
      try {
        const response = await fetch('/api/resend-password-reset', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email: userEmail })
        });

        const data = await response.json();
        if (!response.ok) throw new Error(data.message || 'Failed to resend OTP');
        
        startResendCooldown();
      } catch (error) {
        document.getElementById('errorMessage').textContent = error.message;
      }
    });

    // Resend cooldown timer
    function startResendCooldown() {
      let seconds = 30;
      const resendLink = document.getElementById('resendOtp');
      if (!resendLink) return;
      
      resendLink.style.pointerEvents = 'none';
      clearInterval(cooldownInterval);
      
      cooldownInterval = setInterval(() => {
        resendLink.textContent = `Resend (${seconds}s)`;
        seconds--;
        
        if (seconds < 0) {
          clearInterval(cooldownInterval);
          resendLink.textContent = 'Resend';
          resendLink.style.pointerEvents = 'auto';
        }
      }, 1000);
    }
  </script>
</body>
</html>