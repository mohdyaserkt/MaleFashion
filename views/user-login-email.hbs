<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Encanto Veste | Login</title>
  <link rel="stylesheet" href="/css/encantoVesteAuthPage.css" />
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700&family=Playfair+Display:wght@700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
</head>
<body>
  <div class="auth-grid">
    <!-- Visual Section -->
    <div class="auth-visual" style="background-image: url('https://images.unsplash.com/photo-1600950207944-0d63e8edbc3f?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=1470&q=80')">
      <div class="overlay"></div>
      <div class="branding">
        <div class="logo" style="color:#f0f0f0;">ENCANTO VESTE</div>
        <h2>Where Style Meets Elegance</h2>
        <p>Your premium fashion destination</p>
      </div>
    </div>

    <!-- Form Section -->
    <div class="auth-form">
      <div class="form-container">
        <div class="logo-mobile">ENCANTO VESTE</div>
        <h1>Welcome Back</h1>
        <p class="subtitle">Sign in to your account</p>

        <form id="loginForm" action="/user-login-email" method="post">
          <!-- Email -->
          <div class="input-group">
            <i class="fas fa-envelope"></i>
            <input
              type="email"
              name="email"
              placeholder="Email address"
              required
              pattern="[a-z0-9._%+-]+@[a-z0-9.-]+\.[a-z]{2,}$"
              title="Please enter a valid email address"
            />
          </div>

          <!-- Password -->
          <div class="input-group">
            <i class="fas fa-lock"></i>
            <input
              type="password"
              name="password"
              id="passwordField"
              placeholder="Password"
              required
              pattern="^(?=.*[0-9])(?=.*[!@#$%^&*])[a-zA-Z0-9!@#$%^&*]{8,16}$"
              title="Password must be 8-16 characters, include at least one digit and one special character"
            />
            <button type="button" class="toggle-password" aria-label="Toggle password visibility">
              <i class="fas fa-eye"></i>
            </button>
          </div>

          <!-- Error Message -->
          <p class="text-danger" style="color: red;" id="error-message">{{message}}</p>

          <!-- Remember + Forgot -->
          <div class="form-actions">
            <label class="remember-me">
              <input type="checkbox" name="remember" /> Remember me
            </label>
            <a href="/forget-password-click">Forgot password?</a>
          </div>

          <!-- Submit -->
          <button type="submit" class="btn btn-primary">
            <span>Continue</span>
            <i class="fas fa-arrow-right"></i>
          </button>
        </form>

        <!-- Divider -->
        <div class="divider"><span>or</span></div>

        <!-- OTP Button -->
        <button class="btn btn-otp" onclick="location.href='/user-login-otp'">
          <i class="fas fa-mobile-alt"></i> Continue with OTP
        </button>

        <!-- Create Account -->
        <p class="auth-switch">New to Encanto Veste? <a href="/user-signup">Create account</a></p>
      </div>
    </div>
  </div>
</body>
</html>
